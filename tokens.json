{
  "color": {
    "bg": { "$type": "color", "$value": "#f7f5fc", "$extensions": { "mode": { "dark": "#120c1f" } } },
    "surface": { "$type": "color", "$value": "#ffffff", "$extensions": { "mode": { "dark": "#1c1430" } } },
    "border": { "$type": "color", "$value": "#d8d0ea", "$extensions": { "mode": { "dark": "#352a52" } } },
    "text": { "$type": "color", "$value": "#1e1433", "$extensions": { "mode": { "dark": "#f1edf9" } } },
    "text-muted": { "$type": "color", "$value": "#6a5f80", "$extensions": { "mode": { "dark": "#a99dc2" } } },
    "primary": { "$type": "color", "$value": "#6d3fd6", "$extensions": { "mode": { "dark": "#a98bff" } } },
    "danger": { "$type": "color", "$value": "#c2364f", "$extensions": { "mode": { "dark": "#f27d93" } } },
    "warning": { "$type": "color", "$value": "#9a6400", "$extensions": { "mode": { "dark": "#e3ac4a" } } }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": "Fraunces" },
    "body": { "$type": "fontFamily", "$value": "DM Sans" },
    "mono": { "$type": "fontFamily", "$value": "JetBrains Mono" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "999px" },
    "lg": { "$type": "dimension", "$value": "20px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" }
  }
}
